<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAILTECH - Colony Command</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
        .radar-grid { background-image: radial-gradient(#4b5563 1px, transparent 1px); background-size: 20px 20px; }
        .slot:hover .build-menu { display: block; }
    </style>
</head>
<body class="bg-gray-900 text-gray-300 h-screen flex flex-col font-mono selection:bg-orange-500/30">
    <!-- OOB Error Container -->
    <div id="error-toast" class="empty:hidden fixed top-4 right-4 z-50 transition-opacity duration-300"></div>

    <div id="game-container" hx-get="/game/state" hx-trigger="every 1s" class="flex flex-col h-full">
        <%- include('game_content') %>
    </div>
</body>
</html>
