<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAILTECH - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-200 flex items-center justify-center h-screen">
    <div class="bg-gray-800 p-8 rounded-lg shadow-lg w-96 border border-gray-700">
        <h1 class="text-3xl font-bold text-center text-orange-500 mb-6 font-mono tracking-widest">FAILTECH</h1>

        <% if (error) { %>
            <div class="bg-red-900/50 border border-red-500 text-red-200 px-4 py-2 rounded mb-4 text-sm text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="mb-4">
            <h2 class="text-xl font-semibold mb-4 border-b border-gray-700 pb-2">Terminal Access</h2>
            <div class="mb-4">
                <label class="block text-sm font-medium mb-1 text-gray-400">Commander ID</label>
                <input type="text" name="username" class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500" required>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium mb-1 text-gray-400">Passcode</label>
                <input type="password" name="password" class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-orange-500" required>
            </div>
            <button type="submit" class="w-full bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded transition duration-200 uppercase tracking-wide border border-gray-600 hover:border-gray-500">
                Authenticate
            </button>
        </form>

        <form action="/register" method="POST">
            <input type="hidden" name="username" id="reg-user">
            <input type="hidden" name="password" id="reg-pass">
            <button type="submit" onclick="document.getElementById('reg-user').value = document.getElementsByName('username')[0].value; document.getElementById('reg-pass').value = document.getElementsByName('password')[0].value;" class="w-full bg-transparent hover:bg-gray-700 text-orange-500 font-semibold py-2 px-4 rounded border border-orange-500 hover:border-transparent transition duration-200 text-sm">
                Register New Commander
            </button>
        </form>
    </div>
</body>
</html>
