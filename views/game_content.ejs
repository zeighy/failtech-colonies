<!-- Top Bar HUD -->
<header class="bg-gray-800 border-b border-gray-700 p-2 flex justify-between items-center text-sm shadow-md">
    <div class="flex items-center space-x-6">
        <div class="text-orange-500 font-bold tracking-widest text-lg">FAILTECH</div>
        <div class="flex items-center space-x-2 bg-gray-900 px-3 py-1 rounded border border-gray-700">
            <span class="text-gray-500">CREDITS</span>
            <span class="text-green-400 font-semibold"><%= colony.credits %></span>
        </div>
        <div class="flex items-center space-x-2 bg-gray-900 px-3 py-1 rounded border border-gray-700">
            <span class="text-gray-500">MORALE</span>
            <span class="<%= colony.morale > 50 ? 'text-blue-400' : 'text-red-500 animate-pulse' %> font-semibold"><%= colony.morale %>%</span>
        </div>
        <div class="flex items-center space-x-2 bg-gray-900 px-3 py-1 rounded border border-gray-700">
            <span class="text-gray-500">POPULATION</span>
            <span class="text-gray-300"><%= colony.population %></span>
        </div>
        <div class="flex items-center space-x-2 bg-gray-900 px-3 py-1 rounded border border-gray-700">
            <span class="text-gray-500">TICK</span>
            <span class="text-gray-400"><%= colony.last_tick_processed %></span>
        </div>
    </div>
    <div class="flex items-center space-x-4">
        <form action="/game/reset" method="POST" onsubmit="return confirm('CRITICAL WARNING: This will abandon the colony. All structures will be lost. Proceed?');">
            <button type="submit" class="text-red-500 hover:text-white hover:bg-red-900 border border-red-900 px-3 py-1 rounded transition-colors text-xs uppercase">Abandon Colony</button>
        </form>
        <form action="/logout" method="POST">
            <button type="submit" class="text-gray-400 hover:text-white">Disconnect</button>
        </form>
    </div>
</header>

<div class="flex flex-1 overflow-hidden">
    <!-- Left Panel: Inventory & Production -->
    <aside class="w-64 bg-gray-800 border-r border-gray-700 p-4 flex flex-col overflow-y-auto">
        <h2 class="text-xs text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-700 pb-2">Resource Cache</h2>
        <div class="space-y-3 flex-1">
            <% const resourceNames = { scrap: 'Scrap', energy: 'Energy Grid', unpurified_water: 'Raw Water', clean_water: 'Clean Water', rations: 'Rations', machined_parts: 'Machined Parts' }; %>
            <% for (const [key, label] of Object.entries(resourceNames)) { %>
                <div class="flex justify-between items-center bg-gray-900 p-2 rounded border border-gray-800">
                    <span class="text-sm text-gray-400"><%= label %></span>
                    <span class="font-semibold <%= inventory[key] <= 0 && (key==='clean_water'||key==='rations') ? 'text-red-500 animate-pulse' : 'text-gray-200' %>">
                        <%= Math.floor(inventory[key] || 0) %>
                    </span>
                </div>
            <% } %>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-700">
            <h3 class="text-xs text-gray-500 uppercase mb-2">Consumption Drain</h3>
            <div class="text-xs text-gray-400">Water: -<%= gameConfig.global.populationConsumptionPerTick.clean_water * colony.population %>/t</div>
            <div class="text-xs text-gray-400">Rations: -<%= gameConfig.global.populationConsumptionPerTick.rations * colony.population %>/t</div>
        </div>
    </aside>

    <!-- Center Panel: The Radar Map -->
    <main class="flex-1 bg-gray-900 radar-grid relative overflow-hidden flex items-center justify-center p-8">
        <div class="relative w-[500px] h-[500px] border border-gray-700 rounded-full flex items-center justify-center shadow-[0_0_50px_rgba(0,0,0,0.5)]">
            <!-- Hub (Ring 0) -->
            <div class="absolute w-24 h-24 bg-gray-800 border-2 border-orange-500 rounded-full flex items-center justify-center z-10 shadow-[0_0_15px_rgba(249,115,22,0.3)]">
                <span class="text-orange-500 font-bold text-sm tracking-widest">HUB_01</span>
            </div>

            <!-- Ring 1 Slots -->
            <% const radius = 180; %>
            <% mapSlots.forEach((slot, index) => { %>
                <% const angle = (index * 60) * (Math.PI / 180); %>
                <% const x = Math.cos(angle) * radius; %>
                <% const y = Math.sin(angle) * radius; %>

                <div class="absolute w-20 h-20 -ml-10 -mt-10 rounded border <%= slot ? (slot.type === 'construction' ? 'border-yellow-500 bg-yellow-900/20 border-dashed' : 'border-blue-500 bg-blue-900/20') : 'border-gray-600 border-dashed hover:border-gray-400 bg-gray-800/50 cursor-pointer slot' %> flex items-center justify-center transition-colors shadow-lg group"
                     style="transform: translate(<%= x %>px, <%= y %>px);">

                    <% if (slot) { %>
                        <div class="text-center p-1">
                            <div class="text-[10px] uppercase text-gray-300 leading-tight"><%= slot.name %></div>
                            <% if(slot.type !== 'construction') { %>
                                <div class="text-[8px] text-gray-500 mt-1"><%= slot.type %></div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="text-gray-500 group-hover:text-gray-300 text-2xl font-light">+</div>
                        <!-- Build Menu Dropdown -->
                        <div class="build-menu hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 w-48 bg-gray-800 border border-gray-600 rounded shadow-2xl z-50 p-2">
                            <div class="text-[10px] text-gray-400 uppercase mb-2 border-b border-gray-700 pb-1">Construct Module</div>
                            <div class="space-y-1 max-h-48 overflow-y-auto pr-1 custom-scrollbar">
                                <% for (const [bType, bData] of Object.entries(gameConfig.buildings)) { %>
                                    <form hx-post="/game/build" hx-swap="none" class="m-0">
                                        <input type="hidden" name="ring_index" value="1">
                                        <input type="hidden" name="slot_index" value="<%= index %>">
                                        <input type="hidden" name="building_type" value="<%= bType %>">
                                        <button type="submit" class="w-full text-left p-1.5 hover:bg-gray-700 rounded text-xs transition-colors flex flex-col group/btn">
                                            <span class="text-gray-200 font-semibold"><%= bData.name %></span>
                                            <span class="text-[9px] text-gray-500 mt-0.5 group-hover/btn:text-gray-400 flex flex-wrap gap-1">
                                                <% for(const [cRes, cAmt] of Object.entries(bData.cost)) { %>
                                                    <span class="<%= inventory[cRes] < cAmt ? 'text-red-400' : '' %>"><%= cAmt %> <%= resourceNames[cRes] || cRes %></span>
                                                <% } %>
                                            </span>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </main>

    <!-- Right Panel: Work Orders -->
    <aside class="w-64 bg-gray-800 border-l border-gray-700 p-4 flex flex-col">
        <h2 class="text-xs text-gray-500 uppercase tracking-wider mb-4 border-b border-gray-700 pb-2">Active Queue</h2>
        <div class="space-y-2 flex-1 overflow-y-auto">
            <% if (workOrders.length === 0) { %>
                <div class="text-sm text-gray-600 italic text-center mt-4">No active directives.</div>
            <% } else { %>
                <% workOrders.forEach(wo => { %>
                    <div class="bg-gray-900 border border-gray-700 p-2 rounded relative overflow-hidden">
                        <%
                            let bType = "Unknown";
                            let totalTicks = 1;
                            if(wo.action_type === 'build') {
                                const data = JSON.parse(wo.target_data);
                                bType = gameConfig.buildings[data.building_type]?.name || "Building";
                                totalTicks = gameConfig.buildings[data.building_type]?.constructionTicks || 1;
                            }
                            const pct = Math.max(0, 100 - ((wo.ticks_remaining / totalTicks) * 100));
                        %>
                        <div class="absolute bottom-0 left-0 h-1 bg-orange-500 transition-all duration-1000" style="width: <%= pct %>%"></div>
                        <div class="flex justify-between items-start mb-1 relative z-10">
                            <span class="text-xs text-gray-300 font-semibold">Construct: <%= bType %></span>
                            <span class="text-[10px] text-orange-400 bg-orange-900/30 px-1 rounded"><%= wo.ticks_remaining %>t</span>
                        </div>
                        <div class="text-[10px] text-gray-500 relative z-10 uppercase tracking-wide">Processing...</div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </aside>
</div>
